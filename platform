#!/bin/zsh
#
# Platform utilities for zsh scripts.
#

autoload -U colors && colors

# Returns 0 (success) if Darwin. Otherwise 1 (failure)
function is_darwin() {
    macos="Darwin"
    platform=`uname -a`
    if test "${platform#*$macos}" != "$platform"; then
        return 0 # success
    else
        return 1 # failure
    fi
}

function log_error() {
    msg=$1
    echo "$fg[red]ERROR:$reset_color $msg"
}

function log_warning() {
    msg=$1
    echo "$fg[yellow]WARNING:$reset_color $msg"
}

# Stop whatever is listening on a port.
#
# The socket is what a restart is contending for, and it names its holder
# exactly. Matching `ps` output on a command line did not: a service started
# from inside `private/` reads as `api.py` rather than `private/api.py`, so the
# pattern found nothing, `start` then lost the bind and died quietly, and the
# old process went on serving while every report said the restart had happened.
# That went unnoticed for a day.
#
# Some async services need a second SIGINT — the first closes the server, the
# next raises SystemExit — so this keeps signalling while the port stays held.
# More info @
# https://grpclib.readthedocs.io/en/latest/server.html#grpclib.utils.graceful_exit
#
# A process that will not go gets SIGKILL rather than an endless loop: leaving
# the port held is the one outcome a restart must not end on quietly.
function stop_service {
    port=$1
    if [[ -z "$port" ]]; then
        log_error "stop_service wants a port"
        return 1
    fi

    for attempt in {1..10}; do
        pids=(${(f)"$(lsof -nP -iTCP:$port -sTCP:LISTEN -t 2> /dev/null)"})
        if [[ ${#pids} -eq 0 ]]; then
            return 0
        fi
        for pid in $pids; do
            echo "Stopping: $(ps -p $pid -o comm= 2> /dev/null | tail -1) ($pid) on :$port"
            if [[ $attempt -le 8 ]]; then
                kill $pid 2> /dev/null
            else
                kill -9 $pid 2> /dev/null
            fi
        done
        sleep 0.5
    done

    pids=(${(f)"$(lsof -nP -iTCP:$port -sTCP:LISTEN -t 2> /dev/null)"})
    if [[ ${#pids} -gt 0 ]]; then
        log_error "port $port is still held by ${pids}"
        return 1
    fi
    return 0
}

function start_service {
    service_name=$1
    param=$2
    echo "Starting: $service_name"
    python3 $service_name $param >> /dev/null 2>&1 &
}
