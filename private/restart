#!/bin/zsh

source platform

# A database that has fallen behind the schema its code declares lets the
# service come up and answer 500 from whichever route touches the missing
# table. Rebuilt here, before anything starts, rather than found later.
#
# `--fix` discards every row, which is why this sits in `restart` rather than
# in `start`: `bin/update` calls `start` on the server, and never this.
echo "Checking databases..."
if ! ./bin/check-db --fix; then
    echo "Databases were left as they are. Services have not been started."
    exit 1
fi

# `api.py` mounts every private app, so restarting is restarting the one
# process. The branch that took a single service name could not have worked —
# `start_service api` runs `python3 api` — and there has only ever been one.
./private/stop
./private/start

# A service takes a moment to bind, and a check run before it does reports it
# down. Confirming here is what makes the restart's own answer trustworthy.
sleep 2
echo
./bin/services
