#!/usr/bin/env python3
#
# Validate a BOSS app bundle.
#
# Catches the classes of mistake that only show up at runtime in a browser:
# a controller missing from application.json, an onclick pointing at a function
# that was renamed, a network call to a route nobody implemented, a call to a
# BOSS method that does not exist on that component, or an empty <select> that
# crashes controller init.
#
# Usage:
#   bin/validate-app io.bithead.production
#   bin/validate-app --all
#

import json
import os
import re
import subprocess
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
APP_DIR = os.path.join(REPO, "public/boss/app")
PRIVATE_DIR = os.path.join(REPO, "private/app")

BOSS_SOURCES = [
    "public/boss/ui.js",
    "public/boss/os.js",
    "public/boss/network.js",
    "public/boss/foundation.js",
    "public/boss/notification-manager.js",
    "public/boss/application-manager.js",
    "public/boss/ui-desktop.js",
    "public/boss/ui-notification.js",
]

# Methods reachable through `$(app.controller)` because the UIApplication proxy
# falls through to the Application.html instance. These are not defined by the
# app's own controller, so they must not be reported as unresolved.
PROXY_METHODS = {
    "loadController", "menus", "getControllerNames", "addControllerConfig",
    "applicationDidStart", "applicationDidStop", "openDeepLink",
    "openUniversalLink", "switchApplication", "closeApplication",
}

# Template commands resolved by the OS before a controller is evaluated.
TEMPLATE = [
    ("$(this.id)", "Ctrl_generated"),
    ("$(this.controller)", "os.ui.controller.generated"),
    ("$(app.controller)", "os.application('x').proxy"),
    ("$(app.bundleId)", "io.bithead.example"),
    ("$(app.resourcePath)", "/boss/app/io.bithead.example"),
]


# What each check enforces, and where the rule is written down. Printed by
# `--rules` so no document has to restate the list and then drift from it.
RULES = [
    ("registration", "error", "Controllers match application.json and installed.json", "shared.md §3, §4"),
    ("syntax", "error", "Controller JavaScript parses", "—"),
    ("handlers", "error", "Every onclick resolves to an exported this.*", "shared.md: Controller method naming"),
    ("boss-api", "error", "Every BOSS method called exists on that component", "js-api.md"),
    ("markup", "error", "A <select> in a menu has a name and one <option>", "js.md: UIPopupMenu"),
    ("markup", "error", "A pop-up menu's first option is a prompt carrying no value", "js.md: UIPopupMenu"),
    ("routes", "error", "Every os.network call maps to a declared route", "—"),
    ("models", "error", "Every field read off a response exists on a model", "process.md: Network and Domain Models"),
    ("models", "error", "A route returning a list is read as a list", "process.md: Network and Domain Models"),
    ("models", "error", "A field read off a response exists on that route's model", "process.md: Network and Domain Models"),
    ("accessors", "error", "An element accessor names the tag the element is", "js.md: Element Accessor APIs"),
    ("document", "error", "A document window declares no File menu and one set of controls", "js.md: Document windows"),
    ("naming", "warning", "this.x exposes a function of the same name", "shared.md: Controller method naming"),
    ("controls", "warning", "Buttons run secondary -> primary -> default, one default per row", "shared.md: Button ordering"),
    ("controls", "warning", "didHitEnter calls the default button's function", "shared.md: didHitEnter and default button"),
    ("convention", "warning", "isNumeric() instead of isNaN()", "shared.md: Numeric checks"),
    ("convention", "warning", "isEmpty() instead of comparing against null", "shared.md: Emptiness checks"),
    ("convention", "warning", "Options go through .ui, never the select element", "shared.md: Work through .ui"),
    ("convention", "warning", ".focus() belongs in viewDidAppear", "shared.md: Focus in viewDidAppear"),
    ("convention", "warning", "No 'programmatically' in comments", "shared.md: Comment wording"),
    ("markup", "warning", "Labels carry no trailing colon", "js.md: Labels"),
    ("markup", "warning", "A pop-up menu paired with a button uses `intrinsic`", "js.md: UIPopupMenu"),
    ("markup", "warning", "A secure app's OS bar menus declare who they are for", "js.md: Secure menus"),
    ("dialogs", "warning", "No native alert/confirm/prompt", "js.md: Never use native browser dialogs"),
    ("style", "warning", "No single-line if statements", "shared.md: No single-line if statements"),
]


def print_rules():
    print("Checks performed by bin/validate-app\n")
    width = max(len(r[2]) for r in RULES)
    for check, level, what, where in RULES:
        print(f"  {level:7} {what:<{width}}  [{check}]  {where}")
    print("\nThe rule itself — the correct form and why — is in the document named.")
    print("This lists only what is machine-enforced.")


class Report:
    def __init__(self):
        self.errors = []
        self.warnings = []

    def error(self, check, message):
        self.errors.append((check, message))

    def warn(self, check, message):
        self.warnings.append((check, message))


def boss_api_names():
    names = set()
    for path in BOSS_SOURCES:
        full = os.path.join(REPO, path)
        if not os.path.exists(full):
            continue
        src = open(full).read()
        names |= set(re.findall(r"this\.(\w+)\s*=", src))
        names |= set(re.findall(r"function\s+(\w+)\s*\(", src))
        names |= set(re.findall(r"(?:readOnly|property)\(this,\s*[\"'](\w+)[\"']", src))
    return names


def script_of(html):
    return "\n".join(re.findall(r"<script[^>]*>(.*?)</script>", html, re.S))


def markup_of(html):
    return re.sub(r"<script[^>]*>.*?</script>", "", html, flags=re.S)


def resolve(js):
    for token, replacement in TEMPLATE:
        js = js.replace(token, replacement)
    # Embedded controller refs: %(name) and function %(name)
    js = re.sub(r"function %\((\w+)\)", r"function \1_embedded", js)
    js = re.sub(r"%\((\w+)\)", r"os.ui.controller.\1", js)
    return js


def check_registration(bundle, report):
    cfg_path = os.path.join(APP_DIR, bundle, "application.json")
    if not os.path.exists(cfg_path):
        report.error("registration", "application.json is missing")
        return {}
    try:
        cfg = json.load(open(cfg_path))
    except json.JSONDecodeError as error:
        report.error("registration", f"application.json is not valid JSON: {error}")
        return {}

    # A Godot controller's HTML lives at the bundle root (named by its `main`),
    # not in controller/, so it is not expected to have a controller file.
    declared = {
        name for name, controller in cfg.get("controllers", {}).items()
        if "godot" not in (controller or {})
    }
    main = cfg.get("application", {}).get("main")
    if main == "Application":
        declared.add("Application")

    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    on_disk = set()
    if os.path.isdir(controller_dir):
        on_disk = {f[:-5] for f in os.listdir(controller_dir) if f.endswith(".html")}

    for name in sorted(declared - on_disk):
        report.error("registration", f"{name} is declared in application.json but has no controller file")
    for name in sorted(on_disk - declared):
        # `application-manager.js` only fetches Application.html when `main` is
        # "Application". With any other `main` the file never loads — but an
        # empty stub losing nothing is not a defect. Report only when the file
        # holds logic that the developer would expect to run.
        if name == "Application":
            app_html = open(os.path.join(controller_dir, "Application.html")).read()
            body = script_of(app_html)
            has_logic = (
                bool(re.search(r"this\.\w+\s*=", body))
                or "ui-menus" in app_html
                or "ui-app-menu" in app_html
                or bool(re.search(r"<template\s+id=", app_html))
            )
            if has_logic:
                report.warn(
                    "registration",
                    f'controller/Application.html defines menus or functions but main is "{main}" — '
                    "application-manager.js only loads Application.html when main is "
                    '"Application", so none of it runs'
                )
            continue
        report.error("registration", f"controller/{name}.html exists but is not registered in application.json")

    installed_path = os.path.join(APP_DIR, "installed.json")
    installed = json.load(open(installed_path))
    if bundle not in installed:
        report.warn("registration", "not listed in installed.json — the app will not appear in BOSS")

    return cfg


def check_scripts(bundle, report):
    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return
    has_node = subprocess.run(["which", "node"], capture_output=True).returncode == 0
    if not has_node:
        report.warn("syntax", "node is not installed; skipped JavaScript syntax check")
        return
    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith(".html"):
            continue
        js = resolve(script_of(open(os.path.join(controller_dir, name)).read()))
        check_js(js, name, ".js", report)

    # Module controllers keep their code in a sibling ES module.
    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith(".js"):
            continue
        js = resolve(open(os.path.join(controller_dir, name)).read())
        check_js(js, name, ".mjs", report)


def check_js(js, label, suffix, report):
    """Syntax-check one script. `suffix` selects script vs ES module parsing."""
    with tempfile.NamedTemporaryFile("w", suffix=suffix, delete=False) as handle:
        handle.write(js)
        path = handle.name
    result = subprocess.run(["node", "--check", path], capture_output=True, text=True)
    os.unlink(path)
    if result.returncode != 0:
        first = result.stderr.strip().splitlines()
        detail = next((l for l in first if "Error" in l), first[0] if first else "")
        report.error("syntax", f"{label}: {detail}")


def shared_embedded(bundle):
    """Embedded controllers declared as <template> in Application.html.

    `EmbedController(Name)` injects the template's innerHTML into a controller
    before it is parsed, so the embedded controller it defines is in scope even
    though nothing in the consuming file declares it.

    Returns {templateId: {controllerName: {exports}}}.
    """
    path = os.path.join(APP_DIR, bundle, "controller", "Application.html")
    if not os.path.exists(path):
        return {}
    html = open(path).read()
    templates = {}
    for match in re.finditer(r'<template\s+id="(\w+)"\s*>(.*?)</template>', html, re.S):
        template_id, body = match.group(1), match.group(2)
        controllers = {}
        for block in re.findall(r"<script[^>]*>(.*?)</script>", body, re.S):
            owner = re.search(r"function\s+%\((\w+)\)\s*\(", block)
            if owner is None:
                continue
            controllers[owner.group(1)] = set(re.findall(r"this\.(\w+)\s*=", block))
        templates[template_id] = controllers
    return templates


def module_controllers(cfg):
    """Controllers declared `"module": true` in application.json.

    A module controller separates the view from the controller: the HTML holds
    no `<script>`, and the controller lives in a sibling `<Name>.js` that
    default-exports the same `function Name(view, app)` shape and uses the same
    `this.x = x` convention.
    """
    return {
        name for name, controller in cfg.get("controllers", {}).items()
        if (controller or {}).get("module") is True
    }


def controller_exports(html, module_js=None):
    """Exports per controller, keyed by controller.

    A file may hold a root controller and any number of embedded ones. Each
    script's own function signature says which it is: `function $(this.id)(view)`
    is the root, `function %(name)(view)` is embedded. Pooling their exports
    hides the most common wiring mistake — calling `$(this.controller).foo()`
    for a `foo` that only an embedded controller defines.

    `module_js` is the sibling module source for a module controller; its
    exports belong to the root controller.
    """
    root = set()
    embedded = {}
    for block in re.findall(r"<script[^>]*>(.*?)</script>", html, re.S):
        exports = set(re.findall(r"this\.(\w+)\s*=", block))
        owner = re.search(r"function\s+%\((\w+)\)\s*\(", block)
        if owner is None:
            root |= exports
        else:
            embedded.setdefault(owner.group(1), set()).update(exports)
    if module_js is not None:
        root |= set(re.findall(r"this\.(\w+)\s*=", module_js))
    return root, embedded


def check_handlers(bundle, report, api_names, modules):
    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return
    templates = shared_embedded(bundle)
    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith(".html"):
            continue
        html = open(os.path.join(controller_dir, name)).read()
        js = script_of(html)

        # A module controller's code lives in a sibling .js file.
        module_js = None
        if name[:-5] in modules:
            module_path = os.path.join(controller_dir, name[:-5] + ".js")
            if not os.path.exists(module_path):
                report.error("registration", f'{name} is declared "module": true but {name[:-5]}.js is missing')
            else:
                module_js = open(module_path).read()
                js = js + "\n" + module_js

        root, embedded = controller_exports(html, module_js)

        # Pull in any shared embedded controller this file injects.
        for match in re.finditer(r"EmbedController\((\w+)\)", html):
            template_id = match.group(1)
            # The OS rewrites this sentinel to a real template name at runtime
            # (see showEmbeddedController in ui.js).
            if template_id == "__PREVIEW__":
                continue
            if template_id not in templates:
                report.error("handlers", f"{name}: EmbedController({template_id}) has no <template id=\"{template_id}\"> in Application.html")
                continue
            for controller, exports in templates[template_id].items():
                embedded.setdefault(controller, set()).update(exports)

        # onclick="$(this.controller).foo()" must resolve to a root `this.foo`.
        for match in re.finditer(r"\$\(this\.controller\)\.(\w+)\(", html):
            fn = match.group(1)
            if fn in root or fn in PROXY_METHODS:
                continue
            hint = ""
            owners = [c for c, names in embedded.items() if fn in names]
            if owners:
                hint = f" — did you mean %({owners[0]}).{fn}()?"
            report.error(
                "handlers",
                f"{name}: $(this.controller).{fn}() is not exported by the root controller{hint}"
            )

        # onclick="%(name).foo()" must resolve to that embedded controller.
        for match in re.finditer(r"%\((\w+)\)\.(\w+)\(", html):
            owner, fn = match.group(1), match.group(2)
            if owner not in embedded:
                report.error("handlers", f"{name}: %({owner}) is not an embedded controller in this file")
                continue
            if fn in embedded[owner]:
                continue
            report.error("handlers", f"{name}: %({owner}).{fn}() is not exported by that embedded controller")

        # Calls into the BOSS API must exist somewhere in the OS JavaScript.
        for match in re.finditer(r"(?:view\.ui|\bwin|os\.ui|os\.network|os)\.(\w+)\(", js):
            fn = match.group(1)
            if fn not in api_names:
                report.error("boss-api", f"{name}: calls {fn}() which does not exist in the BOSS API")


def check_selects(bundle, report):
    """An empty <select> in a ui-popup-menu or ui-menu crashes controller init."""
    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return
    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith(".html"):
            continue
        markup = markup_of(open(os.path.join(controller_dir, name)).read())
        for match in re.finditer(
            r'<div[^>]*class="[^"]*ui-(?:popup-menu|menu)[^"]*"[^>]*>(.*?)</div>',
            markup, re.S
        ):
            block = match.group(1)
            select = re.search(r"<select([^>]*)>(.*?)</select>", block, re.S)
            if select is None:
                continue
            if "name=" not in select.group(1):
                report.error("markup", f"{name}: a <select> in a popup/menu has no name attribute")
            if "<option" not in select.group(2):
                report.error(
                    "markup",
                    f"{name}: a <select> in a popup/menu has no <option> at parse time "
                    "(selectedIndex = -1 crashes BOSS during init)"
                )


def check_routes(bundle, report):
    """Every os.network call must map to a route the private service declares."""
    service = os.path.join(PRIVATE_DIR, bundle, "__init__.py")
    if not os.path.exists(service):
        report.warn("routes", "no private service; skipped route cross-check")
        return
    src = open(service).read()
    routes = set()
    for match in re.finditer(r'@router\.(get|post|put|delete)\("([^"]+)"', src):
        routes.add((match.group(1).upper(), re.sub(r"\{[^}]+\}", "{}", match.group(2))))
    prefix_match = re.search(r'APIRouter\(prefix="([^"]+)"', src)
    prefix = prefix_match.group(1) if prefix_match is not None else ""

    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return
    for name in sorted(os.listdir(controller_dir)):
        # Module controllers make their network calls from the sibling .js.
        if not name.endswith((".html", ".js")):
            continue
        html = open(os.path.join(controller_dir, name)).read()
        for match in re.finditer(r"os\.network\.(get|post|put|delete|upload)\(\s*[`\"']([^`\"']+)", html):
            verb, url = match.group(1), match.group(2)
            method = {"upload": "POST", "delete": "DELETE"}.get(verb, verb.upper())
            if prefix not in url:
                continue
            path = re.sub(r"\$\{[^}]+\}", "{}", url.split(prefix)[1].split("?")[0])
            if (method, path) in routes:
                continue
            # A path segment built from a variable (e.g. `/line/${id}/${action}`)
            # can match several routes; accept it if any route has that shape.
            if any(m == method and len(p.split("/")) == len(path.split("/")) for m, p in routes):
                continue
            report.error("routes", f"{name}: {method} {path} has no route in the private service")


# Properties that belong to JavaScript or the DOM, not to a response model.
JS_BUILTINS = {
    "length", "map", "filter", "forEach", "push", "find", "findIndex", "includes",
    "slice", "splice", "sort", "join", "indexOf", "toString", "then", "catch",
    "keys", "values", "entries", "concat", "reverse", "every", "some", "reduce",
    "trim", "split", "replace", "toLowerCase", "toUpperCase", "startsWith",
    "endsWith", "padStart", "charAt", "substring", "repeat", "flat",
}


def check_response_fields(bundle, report):
    """Every field read off a network response must exist on a response model.

    Controllers are written in Stage 1 against invented fixtures and wired to
    real models in Stage 5, so the two drift silently: the route exists, the
    call succeeds, and the screen renders blanks. This compares what the client
    reads with what the service can return.
    """
    # `model.py` is what marks an app as following the network/domain split.
    # Without one there is nothing to compare against — the responses may be
    # assembled by hand, or served by the Swift layer entirely.
    if not os.path.exists(os.path.join(PRIVATE_DIR, bundle, "model.py")):
        return

    # A small service may still keep a model or two in `__init__.py`
    # (shared.md §15), so both are read: the question is whether any model
    # declares the field, not which file it lives in.
    fields = set()
    for source in ("model.py", "__init__.py"):
        path = os.path.join(PRIVATE_DIR, bundle, source)
        if os.path.exists(path):
            fields |= set(re.findall(r"^    ([a-zA-Z][A-Za-z0-9]*)\s*:", open(path).read(), re.M))
    if not fields:
        return

    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return

    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith((".html", ".js")):
            continue
        src = open(os.path.join(controller_dir, name)).read()

        # The variable a response lands in, plus anything iterating over it —
        # `for (const job of response)`, `response.map(function(line) {`.
        holders = set(re.findall(r"(\w+)\s*=\s*await\s+os\.network\.", src))
        for holder in list(holders):
            holders |= set(re.findall(rf"for\s*\(\s*const\s+(\w+)\s+of\s+{holder}\b", src))
            holders |= set(re.findall(rf"{holder}\.map\(\s*function\s*\(\s*(\w+)", src))
        holders.discard("")

        seen = set()
        for holder in sorted(holders):
            for field in re.findall(rf"(?<![.\w]){holder}\.([a-zA-Z][A-Za-z0-9]*)", src):
                if field in JS_BUILTINS or field in fields or field in seen:
                    continue
                seen.add(field)
                report.error("models",
                             f"{name}: reads `{holder}.{field}`, which no response model declares")



# Array methods. Anything else read off an array-returning response names a
# field that does not exist on it.
ARRAY_METHODS = {
    "length", "map", "filter", "forEach", "find", "findIndex", "some", "every",
    "slice", "sort", "reverse", "reduce", "concat", "includes", "indexOf",
    "join", "flat", "at", "keys", "values", "entries",
}

NETWORK_CALL = re.compile(r"""(\w+)\s*=\s*await\s+os\.network\.\w+\(\s*[`"']([^`"']+)""")
NETWORK_CALL_OPEN = re.compile(r"""(\w+)\s*=\s*await\s+os\.network\.\w+\($""")
FIRST_STRING = re.compile(r"""[`"']([^`"']+)""")


def check_array_responses(bundle, report):
    """A route returning a list is read as a list, not unwrapped from an envelope.

    Stage 1 fixtures commonly wrap a list — `{"pools": [...]}` — while the real
    route returns the array itself. The call still succeeds and the screen
    renders nothing, because `response.pools` is `undefined` on an array.

    The `models` check cannot see this. `pools` is a real field on some *other*
    model, so the name resolves and the read looks legitimate.
    """
    service = os.path.join(PRIVATE_DIR, bundle, "__init__.py")
    if not os.path.exists(service):
        return
    src = open(service).read()
    prefix_match = re.search(r'APIRouter\(prefix="([^"]+)"', src)
    prefix = prefix_match.group(1) if prefix_match is not None else ""

    # A route decorator may span lines, so each path is paired with whatever
    # follows it up to the closing parenthesis.
    arrays = set()
    for match in re.finditer(r'@router\.(?:get|post|put|delete)\(\s*"([^"]+)"(.*?)\)\s*\n', src, re.S):
        if "response_model=List[" in match.group(2):
            arrays.add(re.sub(r"\{[^}]+\}", "{}", match.group(1)))
    if not arrays:
        return

    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return

    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith((".html", ".js")):
            continue
        lines = open(os.path.join(controller_dir, name)).read().splitlines()
        for i, line in enumerate(lines):
            match = NETWORK_CALL.search(line)
            if match:
                var, url = match.group(1), match.group(2)
            else:
                # The URL often sits on the line after the call opens.
                opened = NETWORK_CALL_OPEN.search(line.strip())
                following = FIRST_STRING.search(lines[i + 1]) if i + 1 < len(lines) else None
                if opened is None or following is None:
                    continue
                var, url = opened.group(1), following.group(1)

            if prefix not in url:
                continue
            path = re.sub(r"\$\{[^}]+\}", "{}", url.split(prefix)[1].split("?")[0])
            if path not in arrays:
                continue

            # Only the lines that follow, which is roughly the same function —
            # `response` is reused in most controllers.
            window = "\n".join(lines[i:i + 15])
            for prop in sorted(set(re.findall(r"(?<![.\w])" + var + r"\.([a-zA-Z]\w*)", window))):
                if prop in ARRAY_METHODS:
                    continue
                report.error("models",
                             f"{name}:{i + 1}: `{var}.{prop}` — {path} returns an array")


ROUTE_DECORATOR = re.compile(r'@router\.(get|post|put|delete)\(\s*"([^"]+)"(.*?)\)\s*\n', re.S)
RESPONSE_MODEL = re.compile(r"response_model=(?:List\[)?(\w+)")
CLASS_DEF = re.compile(r"^class\s+(\w+)\s*\(([^)]*)\)\s*:", re.M)


def _declared_models(bundle):
    """Every response model in the app, and the fields each declares.

    A base class contributes its fields to whatever inherits it, so the pair is
    resolved rather than read literally.
    """
    bases, own = {}, {}
    for source in ("model.py", "__init__.py"):
        path = os.path.join(PRIVATE_DIR, bundle, source)
        if not os.path.exists(path):
            continue
        text = open(path).read()
        for match in CLASS_DEF.finditer(text):
            name = match.group(1)
            bases[name] = [b.strip() for b in match.group(2).split(",") if b.strip()]
            body = text[match.end():]
            end = re.search(r"^\S", body, re.M)
            own[name] = set(re.findall(r"^    ([a-zA-Z][A-Za-z0-9]*)\s*:",
                                       body[:end.start()] if end else body, re.M))

    def fields_of(name, seen=None):
        seen = seen or set()
        if name in seen or name not in own:
            return set()
        seen.add(name)
        result = set(own[name])
        for base in bases.get(name, []):
            result |= fields_of(base, seen)
        return result

    return {name: fields_of(name) for name in own}


def _route_models(bundle):
    """Normalised `METHOD path` to the model that route returns.

    `List[...]` routes are left out: `check_array_responses` already covers
    reading a field off an array, and it reports the mistake more precisely.
    """
    service = os.path.join(PRIVATE_DIR, bundle, "__init__.py")
    if not os.path.exists(service):
        return "", {}
    src = open(service).read()
    prefix_match = re.search(r'APIRouter\(prefix="([^"]+)"', src)
    prefix = prefix_match.group(1) if prefix_match is not None else ""

    routes = {}
    for match in ROUTE_DECORATOR.finditer(src):
        if "response_model=List[" in match.group(3):
            continue
        model = RESPONSE_MODEL.search(match.group(3))
        if model is None:
            continue
        path = re.sub(r"\{[^}]+\}", "{}", match.group(2))
        routes[f"{match.group(1)} {path}"] = model.group(1)
    return prefix, routes


CALL_WITH_URL = re.compile(r"""(\w+)\s*=\s*await\s+os\.network\.(\w+)\(\s*[`"']([^`"']+)""")
CALL_OPEN = re.compile(r"""(\w+)\s*=\s*await\s+os\.network\.(\w+)\($""")


def check_response_model_fields(bundle, report):
    """A field read off a response exists on *that route's* model.

    `check_response_fields` asks only whether some model somewhere declares the
    name, which is why `left.resources` passed for two months: `resources` is a
    real field on four other models, so the read looked legitimate while
    `LeftLine` never carried one and the operator was never told what to
    return.

    Binding the response to the route that produced it is what makes the
    question answerable.
    """
    models = _declared_models(bundle)
    prefix, routes = _route_models(bundle)
    if not models or not routes:
        return

    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return

    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith((".html", ".js")):
            continue
        lines = open(os.path.join(controller_dir, name)).read().splitlines()
        for i, line in enumerate(lines):
            match = CALL_WITH_URL.search(line)
            if match:
                var, method, url = match.groups()
            else:
                opened = CALL_OPEN.search(line.strip())
                following = FIRST_STRING.search(lines[i + 1]) if i + 1 < len(lines) else None
                if opened is None or following is None:
                    continue
                var, method = opened.group(1), opened.group(2)
                url = following.group(1)

            if prefix not in url:
                continue
            path = re.sub(r"\$\{[^}]+\}", "{}", url.split(prefix)[1].split("?")[0])
            model = routes.get(f"{method} {path}")
            if model is None or model not in models:
                continue

            # The same window the array check uses: `response` is reused across
            # a controller, so only the reads near this call are attributable.
            window = "\n".join(lines[i:i + 15])
            for prop in sorted(set(re.findall(r"(?<![.\w])" + var + r"\.([a-zA-Z]\w*)", window))):
                if prop in JS_BUILTINS or prop in models[model]:
                    continue
                report.error("models",
                             f"{name}:{i + 1}: `{var}.{prop}` — {path} returns {model},"
                             f" which declares no such field")


POPUP_SELECT = re.compile(r"<select\b[^>]*>(?:.*?)</select>", re.S)
FIRST_OPTION = re.compile(r"<option\b([^>]*)>")
OPTION_VALUE = re.compile(r'value\s*=\s*"([^"]*)"')


def check_popup_first_option(bundle, report):
    """A pop-up menu's first option is its prompt, and a prompt carries no value.

    `UIPopupMenu.selectedValue()` returns `null` whenever `selectedIndex` is 0 —
    the label is not a selectable value — and `styleOptions` renders choices
    from index 1, so option 0 never appears in the list.

    A real choice placed there can be written but never read back through the
    component. A controller reading it gets `null` and behaves as though
    nothing was chosen — which has produced a form with every field hidden, and
    a list that loaded filtered to a state that does not exist.

    Reading the raw `select.value` instead does return it, so such a control
    can look fine while breaking the moment someone follows the convention and
    goes through `.ui`. That is worth reporting on its own: it is a trap laid
    for whoever tidies the code next.

    Whatever value option 0 carries is never read, so the fix is to make it a
    prompt — `<option>Choose one</option>` — and move the real choice down.
    """
    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return

    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith(".html"):
            continue
        src = open(os.path.join(controller_dir, name)).read()
        for match in POPUP_SELECT.finditer(src):
            # Only pop-up menus. A list box's options are all real values, and
            # its own `selectedValue` has no such rule.
            if "ui-popup-menu" not in src[:match.start()][-400:]:
                continue
            first = FIRST_OPTION.search(match.group(0))
            if first is None:
                continue
            value = OPTION_VALUE.search(first.group(1))
            if value is None or not value.group(1):
                continue
            select_name = re.search(r'name="([^"]+)"', match.group(0))
            select_name = select_name.group(1) if select_name else "?"
            line = src[:match.start()].count("\n") + 1
            report.error(
                "markup",
                f"{name}:{line}: pop-up `{select_name}` puts a real choice "
                f"(value=\"{value.group(1)}\") first — that slot is the label, "
                f"and `selectedValue()` returns null for it")


def is_minified(source):
    """Generated bundles (Godot glue, minified libraries) are not hand-written.

    Scanning them produces thousands of meaningless hits, so skip anything with
    an implausibly long line.
    """
    return any(len(line) > 2000 for line in source.splitlines())


# Raw browser dialogs are blocking, unstyled, and break the BOSS look and feel.
DIALOGS = {
    "alert": "os.ui.showAlert(msg)",
    "confirm": "os.ui.showDelete(msg, cancelFn, okFn)",
    "prompt": "a modal UIController (BOSS has no prompt API)",
}
DIALOG_PATTERN = re.compile(r"(?<![.\w])(?:window\.)?(alert|confirm|prompt)\s*\(")


def check_dialogs(bundle, report):
    """Flag native browser dialogs; BOSS provides styled equivalents."""
    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return
    for name in sorted(os.listdir(controller_dir)):
        path = os.path.join(controller_dir, name)
        if not name.endswith((".html", ".js")):
            continue
        source = open(path).read()
        if is_minified(source):
            continue

        # Walk the whole file rather than an extracted script body so reported
        # line numbers match the file the developer will open.
        is_html = name.endswith(".html")
        in_script = not is_html
        for number, line in enumerate(source.splitlines(), start=1):
            if is_html:
                if "<script" in line:
                    in_script = True
                elif "</script>" in line:
                    in_script = False
                    continue
            if not in_script:
                continue
            stripped = line.strip()
            if stripped.startswith(("//", "*", "/*")):
                continue
            match = DIALOG_PATTERN.search(line)
            if match is None:
                continue
            fn = match.group(1)
            report.warn(
                "dialogs",
                f"{name}:{number}: native {fn}() — use {DIALOGS[fn]}"
            )


# `this.delete = _delete` is required — `delete` is reserved. `didHit*` handlers
# are aliases by design (`this.didHitEnter = save`), and so is
# `windowShouldClose`: closing a window is leaving it, which is what Cancel
# already means, so a form that owns a draft answers the close with the same
# function (`this.windowShouldClose = cancel`).
NAMING_EXEMPT = {"didHitEnter", "didHitKey", "didHitCancel", "windowShouldClose"}

# Button classes in the order they must appear inside `div.controls`.
BUTTON_ORDER = {"secondary": 0, "primary": 1, "default": 2}


def controller_files(bundle):
    """Yield (name, full source) for every controller file in a bundle."""
    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return
    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith((".html", ".js")):
            continue
        source = open(os.path.join(controller_dir, name)).read()
        if is_minified(source):
            continue
        yield name, source


# `view.ui.<accessor>(name)` — or `win.<accessor>(name)`, the same object under
# the name the OS passes it by — queries `<tag name="...">`, so the accessor has to
# name the tag the element actually is. Asking for the wrong one returns `null`,
# and the next property read raises `TypeError: Cannot read properties of null`.
ACCESSOR_TAGS = {
    "button": {"button"}, "div": {"div"}, "span": {"span"}, "input": {"input"},
    "select": {"select"}, "textarea": {"textarea"}, "table": {"table"},
    "img": {"img"}, "p": {"p"}, "pre": {"pre"}, "td": {"td"},
    "fieldset": {"fieldset"}, "iframe": {"iframe"}, "details": {"details"},
}
# A name assembled at run time: `input.name = "attr-" + attr.id`.
RUNTIME_NAME = re.compile(r'\.name\s*=\s*"([^"]*)"\s*\+')
# A name given to a component the factories build, which the markup never
# declares by design: `os.ui.makePopupMenu("made-popup", …)`. Also a name
# assigned outright to an element created in script.
FACTORY_NAME = re.compile(r'(?:os\.ui\.make\w+\(\s*|\.name\s*=\s*)"([^"]+)"')
ACCESSOR_CALL = re.compile(r'(?:\.ui|\bwin)\.(' + "|".join(ACCESSOR_TAGS) + r')\("([^"]+)"\)')
NAMED_ELEMENT = re.compile(r'<(\w+)[^>]*\bname="([^"]+)"')


def check_accessors(bundle, report):
    """An element accessor must name the tag the element is.

    `view.ui.div("kiosk-close-btn")` where the markup says
    `<button name="kiosk-close-btn">` returns `null`, and the screen dies on the
    next property read — at whatever moment that branch first runs, which for a
    payment step or an operator-only control can be long after the change that
    broke it.

    A name the markup declares under a different tag is a certain crash. A name
    the markup never declares at all is the same crash by a different route —
    `view.ui.span("confirm-business-phone")` where nothing carries that name
    returns `null`, and the confirmation screen dies one property read later,
    after the appointment has already been booked. Both are reported.

    Names built at run time are exempt: a controller that writes
    `input.name = "attr-" + attr.id` is addressing something the markup could
    never have declared, so any accessor sharing that prefix is left alone.
    """
    for name, source in controller_files(bundle):
        if not name.endswith(".html"):
            continue
        declared = {}
        for tag, element in NAMED_ELEMENT.findall(markup_of(source)):
            declared.setdefault(element, set()).add(tag.lower())
        # A module controller keeps its markup in `<Name>.html` and its script
        # in `<Name>.js`, so the two have to be read together or the pairing
        # this check exists to verify is never seen.
        script = script_of(source)
        module = os.path.join(APP_DIR, bundle, "controller", name[:-5] + ".js")
        if os.path.exists(module):
            script += "\n" + open(module).read()
        # `input.name = "attr-" + attr.id` — the prefix of a name assembled at
        # run time. Anything starting with one of these is not the markup's to
        # declare.
        prefixes = tuple(RUNTIME_NAME.findall(script))
        made = set(FACTORY_NAME.findall(script))
        for number, line in enumerate(script.splitlines(), start=1):
            for accessor, element in ACCESSOR_CALL.findall(line):
                tags = declared.get(element)
                if tags is not None:
                    if tags & ACCESSOR_TAGS[accessor]:
                        continue
                    actual = "/".join(sorted(tags))
                    report.error(
                        "accessors",
                        f'{name}: `.ui.{accessor}("{element}")` — the markup declares'
                        f' <{actual} name="{element}">, so this reads null'
                    )
                    continue
                if element in made:
                    continue
                if prefixes and element.startswith(prefixes):
                    continue
                report.error(
                    "accessors",
                    f'{name}:{number}: `.ui.{accessor}("{element}")` — nothing in'
                    f' the markup carries that name, so this reads null'
                )


UI_MENU = re.compile(r'<div[^>]*class="([^"]*\bui-menu\b[^"]*)"')


def check_secure_menus(bundle, report):
    """A secure app's OS bar menus declare who they are for.

    `secure` hides a menu from a guest, `super-user` from everyone but the
    super user. A menu declaring neither is shown to whoever is looking, which
    in a secure app is usually an oversight rather than a decision — the app
    exists to be signed in to.

    The first menu is exempt. It is the app's own — About and Quit — and a
    guest reading a welcome screen has to be able to leave.
    """
    cfg_path = os.path.join(APP_DIR, bundle, "application.json")
    if not os.path.exists(cfg_path):
        return
    try:
        cfg = json.load(open(cfg_path))
    except json.JSONDecodeError:
        return
    if cfg.get("application", {}).get("secure") is not True:
        return

    app_html = os.path.join(APP_DIR, bundle, "controller", "Application.html")
    if not os.path.exists(app_html):
        return
    markup = markup_of(open(app_html).read())
    block = re.search(r'<div class="ui-menus">(.*?)</div>\s*(?:<!--.*?-->\s*)*</div>',
                      markup, re.S)
    if block is None:
        return
    for index, classes in enumerate(UI_MENU.findall(block.group(1))):
        if index == 0:
            continue
        names = classes.split()
        if "secure" in names or "super-user" in names:
            continue
        report.warn(
            "markup",
            f"Application.html: OS bar menu {index + 1} declares neither `secure`"
            f" nor `super-user` — in a secure app a guest would see it"
        )


DOCUMENT_OPT_IN = re.compile(r"this\.document\s*=\s*new\s+UIDocument\b")
FILE_MENU = re.compile(r'<select[^>]*name="file-menu"')
# `controls` as a whole class, not as the head of `controls-right` — that one
# belongs to a list box's button group and has nothing to do with a document.
CONTROLS_ROW = re.compile(r'<div[^>]*class="(?:[^"]*\s)?controls(?:\s[^"]*)?"')

# The three the OS knows how to ask about. A button that does anything else
# keeps its own `onclick` and stands beside them.
DOCUMENT_ACTIONS = {"cancel", "delete", "save"}

# A `save` that only logs is a demonstration; one that writes is a document.
NETWORK_WRITE = re.compile(r"os\.network\.(?:post|put|patch|delete)\b")

# A controller that names the window in its signature.
WINDOW_PARAM = re.compile(r"function\s+[\w$().]+\(\s*view\s*,\s*win\s*\)")


def check_document_windows(bundle, report):
    """A document declares no File menu, and exactly one set of controls.

    The OS generates the File menu from the controls and points each item at
    the same handler as its button — the one that asks before deleting and
    refuses a second press mid-save. A hand-written menu calls the controller
    straight through and skips all of it, and because it *exists* the OS
    declines to generate the working one.

    One `div.controls`, because the OS disables every control in the window
    while an action runs and reads the default button from that set. A second
    row makes both of those ambiguous.
    """
    for name, source in controller_files(bundle):
        if not name.endswith(".html"):
            continue
        script = script_of(source) if name.endswith(".html") else source
        module = os.path.join(APP_DIR, bundle, "controller", name[:-5] + ".js")
        if os.path.exists(module):
            script += "\n" + open(module).read()
        if DOCUMENT_OPT_IN.search(script) is None:
            continue

        markup = markup_of(source)
        if FILE_MENU.search(markup) is not None:
            report.error(
                "document",
                f"{name}: declares a File menu — a document's is generated from its"
                f" controls, and a declared one bypasses the document actions"
            )
        rows = len(CONTROLS_ROW.findall(markup))
        if rows != 1:
            report.error(
                "document",
                f"{name}: has {rows} `div.controls` — a document has exactly one,"
                f" since the OS disables that set and reads the default from it"
            )

        # `doc-action` names one of the three the OS knows how to ask about,
        # and the controller has to expose it. Anything else is a button that
        # silently does nothing, which is worse than one that is not there.
        for action in re.findall(r'doc-action="([^"]*)"', markup):
            if action not in DOCUMENT_ACTIONS:
                report.error(
                    "document",
                    f"{name}: doc-action=\"{action}\" is not one of"
                    f" {', '.join(sorted(DOCUMENT_ACTIONS))}"
                )
                continue
            if re.search(r"\bthis\.%s\s*=" % action, script) is None:
                report.error(
                    "document",
                    f"{name}: doc-action=\"{action}\" has no `this.{action}` to call"
                )


def function_body(js, name):
    """The text of `function <name>(...) { ... }`, by counting braces.

    Indentation cannot be relied on to find the end — a controller function
    sits at one depth, the same function inside an embedded controller at
    another — and a regex that stops at the first `}` stops inside the first
    `if`.
    """
    match = re.search(r"function\s+%s\s*\([^)]*\)\s*\{" % re.escape(name), js)
    if match is None:
        return None
    depth, i = 1, match.end()
    while i < len(js) and depth > 0:
        if js[i] == "{":
            depth += 1
        elif js[i] == "}":
            depth -= 1
        i += 1
    return js[match.end():i - 1]


def check_undeclared_documents(bundle, report):
    """A window that edits one record should say so.

    A `.ui-window` whose controls row holds a Save that writes to the network
    is a document by the test in `process.md` — and hand-rolling one means its
    Cancel asks a question of its own invention, its Delete may not ask at all,
    and a double-tapped Save writes twice.

    The write is what separates a document from a gallery: the tutorial's
    button-styling row calls a `save` that only logs, and is not one.

    A warning, not an error. Some windows genuinely are the exception, and the
    answer is a conversation with the developer rather than a rewrite — see
    `process.md`, "Name the documents while planning".
    """
    for name, source in controller_files(bundle):
        if not name.endswith(".html"):
            continue
        if '<div class="ui-window"' not in source:
            continue
        js = script_of(source)
        module = os.path.join(APP_DIR, bundle, "controller", name[:-5] + ".js")
        if os.path.exists(module):
            js += "\n" + open(module).read()
        if DOCUMENT_OPT_IN.search(js) is not None:
            continue

        markup = markup_of(source)
        for row in re.finditer(CONTROLS_ROW.pattern + r"(.*?)</div>", markup, re.S):
            block = row.group(1)
            # A nested `.controls` means this match swallowed a row that is not
            # the window's own; the inner one is matched on its own turn.
            if re.search(r'<div[^>]*class="[^"]*\bcontrols\b', block) is not None:
                continue
            calls = re.findall(r'onclick="[^"]*\.(\w+)\(', block)
            if "save" not in calls:
                continue
            body = function_body(js, "save")
            if body is None or NETWORK_WRITE.search(body) is None:
                continue
            report.warn(
                "document",
                f"{name}: a Save that writes a record, but no `this.document` —"
                f" declare it a document, or say why it is not"
            )
            break


def check_window_shadowing(bundle, report):
    """A controller that takes `win` must not declare another one.

    `function $(this.id)(view, win)` names the window `win` for the whole
    controller. A child window loaded inside a function — `const win = await
    loadController(...)` — takes the name back, and every `win.input(...)`
    earlier in that same function stops meaning the window. Reading one above
    the declaration is not even a wrong window: `const` hoists into a dead
    zone, so it throws.

    Name the child something else. This is an error rather than a warning
    because the failure is a `ReferenceError` on a branch that may not run
    until the day somebody presses Edit.
    """
    for name, source in controller_files(bundle):
        js = script_of(source) if name.endswith(".html") else source
        module = os.path.join(APP_DIR, bundle, "controller", name[:-5] + ".js")
        if name.endswith(".html") and os.path.exists(module):
            js += "\n" + open(module).read()
        if WINDOW_PARAM.search(js) is None:
            continue
        for match in re.finditer(r"^\s*(?:const|let|var)\s+win\s*=", js, re.M):
            line = js[:match.start()].count("\n") + 1
            report.error(
                "shadow",
                f"{name}:{line}: declares `win`, which is already the window —"
                f" name the other one something else"
            )


def check_naming(bundle, report):
    """`this.x = y` must name the same function it exposes."""
    for name, source in controller_files(bundle):
        js = script_of(source) if name.endswith(".html") else source
        for match in re.finditer(r"^\s*this\.(\w+)\s*=\s*(\w+);", js, re.M):
            prop, fn = match.group(1), match.group(2)
            if prop == fn or prop in NAMING_EXEMPT:
                continue
            # `this.delete = _delete` — an underscore dodges a reserved word.
            if fn == "_" + prop:
                continue
            report.warn("naming", f"{name}: this.{prop} exposes {fn}() — the names must match")


def check_controls(bundle, report):
    """Button order and the single-default rule inside `div.controls`."""
    for name, source in controller_files(bundle):
        if not name.endswith(".html"):
            continue
        markup = markup_of(source)
        for block in re.finditer(r'<div class="controls"[^>]*>(.*?)</div>', markup, re.S):
            seen = []
            for button in re.finditer(r'<button[^>]*class="([^"]*)"', block.group(1)):
                classes = button.group(1).split()
                for cls in classes:
                    if cls in BUTTON_ORDER:
                        seen.append(cls)
                        break
            ranks = [BUTTON_ORDER[c] for c in seen]
            if ranks != sorted(ranks):
                report.warn(
                    "controls",
                    f"{name}: buttons are {' -> '.join(seen)}; order must be secondary -> primary -> default"
                )
            # Counted per button row, not per file: a window may hold several
            # `div.controls` in panes that are never visible at the same time.
            if seen.count("default") > 1:
                report.warn("controls", f"{name}: {seen.count('default')} default buttons in one row — only one")


def check_default_action(bundle, report):
    """`didHitEnter` and the default button must call the same function."""
    for name, source in controller_files(bundle):
        js = script_of(source) if name.endswith(".html") else source
        enter = re.search(r"this\.didHitEnter\s*=\s*(\w+);", js)
        if enter is None:
            continue
        markup = markup_of(source) if name.endswith(".html") else ""
        buttons = re.findall(
            r'<button[^>]*class="[^"]*\bdefault\b[^"]*"[^>]*onclick="[^"]*\.(\w+)\(',
            markup
        )
        # With more than one default button the pairing is ambiguous — a
        # window shows different panes at different times.
        if len(buttons) != 1:
            continue
        if enter.group(1) != buttons[0]:
            report.warn(
                "controls",
                f"{name}: didHitEnter calls {enter.group(1)}() but the default button calls {buttons[0]}()"
            )


def check_conventions(bundle, report):
    """Rules from shared.md that a regex can decide."""
    patterns = [
        (r"\bisNaN\s*\(", "isNaN() — use isNumeric() from foundation.js"),
        (r"[!=]==?\s*null\b", "comparison against null — use isEmpty()"),
        (r"\.options\.length\s*=\s*0", "direct select manipulation — use .ui.removeAllOptions()"),
        (r"\.add\(new Option\(", "direct select manipulation — use .ui.addNewOptions()"),
        (r"\bprogrammatically\b", "the word 'programmatically' is superfluous in a comment"),
    ]
    for name, source in controller_files(bundle):
        js = script_of(source) if name.endswith(".html") else source
        for number, line in enumerate(js.splitlines(), start=1):
            for pattern, message in patterns:
                if re.search(pattern, line):
                    report.warn("convention", f"{name}: {message}")
                    break

        # `.focus()` belongs in viewDidAppear, once the view is visible.
        did_load = re.search(r"function viewDidLoad\s*\([^)]*\)\s*\{(.*?)\n      \}", js, re.S)
        if did_load is not None and ".focus()" in did_load.group(1):
            report.warn("convention", f"{name}: .focus() in viewDidLoad — move it to viewDidAppear")


def check_popup_rows(bundle, report):
    """A pop-up menu paired with a button is one unit and needs `intrinsic`.

    Without it the label sits in the fixed 90px label column and the row reads
    as two separate things. Only rows holding just a menu and button(s) are
    considered — a row that also carries a list box, table, or text field is a
    layout, not a paired control.
    """
    for name, source in controller_files(bundle):
        if not name.endswith(".html"):
            continue
        markup = markup_of(source)
        for match in re.finditer(r'<div class="(hbox[^"]*)"[^>]*>', markup):
            depth, i = 1, match.end()
            while depth and i < len(markup):
                nxt_open = markup.find("<div", i)
                nxt_close = markup.find("</div>", i)
                if nxt_close == -1:
                    break
                if nxt_open != -1 and nxt_open < nxt_close:
                    depth += 1
                    i = nxt_open + 4
                else:
                    depth -= 1
                    i = nxt_close + 6
            block = markup[match.end():i]
            if "ui-popup-menu" not in block or "<button" not in block:
                continue
            if any(tag in block for tag in ("ui-list-box", "<table", "text-field", "controls-right")):
                continue
            if "intrinsic" in block:
                continue
            line = markup[:match.start()].count("\n") + 1
            report.warn(
                "markup",
                f"{name}:{line}: a pop-up menu paired with a button needs the "
                "`intrinsic` class so they read as one row"
            )


def check_labels(bundle, report):
    """Labels carry text only — no trailing colon."""
    for name, source in controller_files(bundle):
        if not name.endswith(".html"):
            continue
        for match in re.finditer(r"<label[^>]*>([^<]*?):\s*</label>", markup_of(source)):
            report.warn("markup", f"{name}: label \"{match.group(1)}:\" has a trailing colon")


def check_style(bundle, report):
    controller_dir = os.path.join(APP_DIR, bundle, "controller")
    if not os.path.isdir(controller_dir):
        return
    for name in sorted(os.listdir(controller_dir)):
        if not name.endswith(".html"):
            continue
        for number, line in enumerate(open(os.path.join(controller_dir, name)), start=1):
            if re.search(r"\bif\s*\(.*\)\s*\{[^}]*\S[^}]*\}", line) and "//" not in line.split("if")[0]:
                report.warn("style", f"{name}:{number}: single-line if statement (expand to multiple lines)")


def is_app_bundle(bundle):
    """A bundle is a BOSS app only if it has config or controllers.

    `public/boss/app/` also holds plain web pages and scratch directories.
    """
    path = os.path.join(APP_DIR, bundle)
    return (os.path.exists(os.path.join(path, "application.json"))
            or os.path.isdir(os.path.join(path, "controller")))


def validate(bundle, api_names):
    report = Report()
    cfg = check_registration(bundle, report)
    check_scripts(bundle, report)
    check_handlers(bundle, report, api_names, module_controllers(cfg))
    check_selects(bundle, report)
    check_routes(bundle, report)
    check_response_fields(bundle, report)
    check_array_responses(bundle, report)
    check_response_model_fields(bundle, report)
    check_popup_first_option(bundle, report)
    check_dialogs(bundle, report)
    check_accessors(bundle, report)
    check_document_windows(bundle, report)
    check_window_shadowing(bundle, report)
    check_undeclared_documents(bundle, report)
    check_secure_menus(bundle, report)
    check_naming(bundle, report)
    check_controls(bundle, report)
    check_default_action(bundle, report)
    check_conventions(bundle, report)
    check_popup_rows(bundle, report)
    check_labels(bundle, report)
    check_style(bundle, report)

    print(f"\n{bundle}")
    if not report.errors and not report.warnings:
        print("  OK")
    for check, message in report.errors:
        print(f"  ERROR   [{check}] {message}")
    for check, message in report.warnings:
        print(f"  warning [{check}] {message}")
    return len(report.errors)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if "--rules" in sys.argv:
        print_rules()
        return 0
    if "--all" in sys.argv:
        bundles = sorted(
            b for b in os.listdir(APP_DIR)
            if os.path.isdir(os.path.join(APP_DIR, b)) and is_app_bundle(b)
        )
    elif args:
        bundles = args
    else:
        print(__doc__ or "Usage: bin/validate-app <bundle_id> | --all")
        return 2

    api_names = boss_api_names()
    failures = 0
    for bundle in bundles:
        if not os.path.isdir(os.path.join(APP_DIR, bundle)):
            print(f"\n{bundle}\n  ERROR   [bundle] no such app bundle")
            failures += 1
            continue
        failures += validate(bundle, api_names)

    print()
    if failures > 0:
        print(f"{failures} error(s)")
        return 1
    print("No errors.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
