#!/usr/bin/env python3
#
# Verify that every private service still loads.
#
# `api.py` imports each app under `private/app/` and appends its `router`. An
# app whose module raises during import is logged and skipped:
#
#     try:
#         spec.loader.exec_module(module)
#     except Exception as e:
#         logging.error(...)
#         continue
#
# So a broken app does not stop the service. The service starts, binds its
# port, and answers every request for that app with FastAPI's own 404 — a total
# outage of one app, wearing the costume of a routing mistake. An app with no
# `router` attribute is skipped the same way.
#
# The one record of it is a log line, and `private/start` sends the service's
# output to /dev/null. Nothing else notices, which is what this is for.
#
# The tests do not cover it: they import `lib` directly and never load the
# router, so a suite can be entirely green while the service serves nothing.
#
# What this does not do is call `start()`. That would create and migrate real
# databases, which a check has no business doing. Worth knowing that `api.py`
# calls it *outside* the try above, so an exception there is not caught at all
# and takes down every app rather than one.
#
# Usage:
#   bin/check-services
#

import ast
import importlib.util
import os
import re
import sys
import traceback

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
APP_DIR = os.path.join(REPO, "private", "app")

# `api.py` runs with `private/` as its working directory, so an app's
# `from lib import …` resolves. Added explicitly rather than left to whatever
# directory this is run from.
sys.path.insert(0, os.path.join(REPO, "private"))

from lib import schema  # noqa: E402  (after the path is set)


def load(name):
    """Import an app the way `api.py` does. Returns the module or an error."""
    path = os.path.join(APP_DIR, name, "__init__.py")
    if not os.path.isfile(path):
        return None, "no __init__.py"

    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    # As `api.py` does, so relative imports inside the app resolve.
    sys.modules[name] = module
    try:
        spec.loader.exec_module(module)
    except Exception:
        return None, traceback.format_exc(limit=3).strip()
    return module, None


CLASS_DEF = re.compile(r"^class (\w+)\(", re.M)
# A decorator may wrap across lines once its arguments are long, so this reads
# to the closing bracket rather than to the end of the line. Counting only
# single-line ones made four routes invisible — neither declared nor missing.
ROUTE_DEF = re.compile(r"^@router\.(\w+)\((.*?)\)\s*\n(?=@|async |def )",
                       re.M | re.S)


def _model_problems(name):
    """A model name declared twice is always a bug.

    Python keeps the last definition, so the earlier one is shadowed with
    nothing said. A route declaring it then returns a shape nobody wrote.
    """
    path = os.path.join(APP_DIR, name, "model.py")
    if not os.path.isfile(path):
        return []
    seen, twice = set(), []
    for match in CLASS_DEF.finditer(open(path).read()):
        if match.group(1) in seen:
            twice.append(match.group(1))
        seen.add(match.group(1))
    return [f"  ERROR   {name}: model.py declares {n} twice; the first is shadowed"
            for n in sorted(set(twice))]


FIELD_DEF = re.compile(r"^    (\w+)\s*:", re.M)


def _shape_problems(name):
    """Models declaring the same field set.

    Usually one model written twice — a `POST` and a `PUT` returning the same
    thing, each named after its route. Sometimes two ideas that coincide, where
    the name is the only thing keeping them apart, and then both should stay.

    Which is which is a reading, not a rule, so this is a warning: it puts the
    groups in front of you rather than leaving them to be found by whoever
    wonders why two models look alike.
    """
    path = os.path.join(APP_DIR, name, "model.py")
    if not os.path.isfile(path):
        return []

    text = open(path).read()
    # A class runs to the next one at column zero, so fields are read from that
    # span rather than from the whole file.
    bounds = [(m.group(1), m.start()) for m in CLASS_DEF.finditer(text)]
    shapes = {}
    for i, (model, start) in enumerate(bounds):
        end = bounds[i + 1][1] if i + 1 < len(bounds) else len(text)
        fields = frozenset(FIELD_DEF.findall(text[start:end]))
        if not fields:
            continue
        shapes.setdefault(fields, []).append(model)

    problems = []
    for fields, models in sorted(shapes.items(), key=lambda kv: sorted(kv[1])):
        if len(models) < 2:
            continue
        listed = ", ".join(sorted(models))
        problems.append(f"  warning {name}: {listed} declare the same fields"
                        f" ({', '.join(sorted(fields))}) — one model, or two"
                        f" ideas the names keep apart?")
    return problems


# The responses that carry a file rather than a shape. A route returning one
# has nothing to declare, and is read as such rather than saying so.
RAW_RESPONSES = {"Response", "FileResponse", "StreamingResponse",
                 "PlainTextResponse", "HTMLResponse", "RedirectResponse"}


def _returns_a_file(function) -> bool:
    """Whether a handler hands back a response object of its own."""
    for node in ast.walk(function):
        if not isinstance(node, ast.Return) or node.value is None:
            continue
        call = node.value
        if isinstance(call, ast.Call) and isinstance(call.func, ast.Name) \
                and call.func.id in RAW_RESPONSES:
            return True
    return False


def _route_problems(name, module):
    """Routes that do not say what shape they return.

    `response_model=` is what binds a route to a model, and it is what
    `bin/validate-app` reads to ask whether every field the client takes off
    that route exists on it. Without one, only the weaker question is asked —
    does *any* model declare this field — which passes for a field that is real
    somewhere else entirely.

    A route handing back a `Response` is carrying a file, and is left out of
    the count: the return says so.

    A warning: a route still returning its Stage 1 fixture has nothing to
    declare yet, and the count is what is left to wire.
    """
    path = os.path.join(APP_DIR, name, "__init__.py")
    if not os.path.isfile(path):
        return []

    try:
        tree = ast.parse(open(path).read())
    except SyntaxError:
        return []

    declared = undeclared = 0
    for node in ast.walk(tree):
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        decorators = [d for d in node.decorator_list
                      if isinstance(d, ast.Call)
                      and isinstance(d.func, ast.Attribute)
                      and isinstance(d.func.value, ast.Name)
                      and d.func.value.id == "router"]
        if not decorators:
            continue
        for decorator in decorators:
            if any(k.arg == "response_model" for k in decorator.keywords):
                declared += 1
            elif _returns_a_file(node):
                declared += 1
            else:
                undeclared += 1

    if not undeclared:
        return []
    return [f"  warning {name}: {undeclared} of {declared + undeclared} routes"
            f" declare no response_model"]


def _database_problems(name, module):
    """A database that has fallen behind the schema its code declares.

    Read-only here. `bin/check-db --fix` is what rebuilds one, and it is a
    development tool — this only says which need it.
    """
    db = getattr(module, "db", None)
    create_schema = getattr(db, "create_schema", None)
    get_db_path = getattr(db, "get_db_path", None)
    if create_schema is None or get_db_path is None:
        return []
    try:
        missing = schema.drift(create_schema, get_db_path())
    except Exception:
        return [f"  ERROR   {name}: its schema would not build"]
    if not missing:
        return []
    return [f"  ERROR   {name}: its database is missing {', '.join(missing)}"
            f" — run `bin/check-db --fix`"]


# An app grants its own roles and no other app's.
#
# `grant_role` and `grant_license` read the bundle off the calling module, so
# an app has no argument to get wrong. But every private app shares one
# process, and BOSS's `/private/acl/role` believes the `bundleId` it is sent —
# so the reading is a convenience, and what makes it a boundary is that
# nothing goes around it.
#
# Three ways around it, and this is all of them: posting to BOSS directly,
# reaching the helper that does, or asking `calling_bundle` about a module
# that is not the caller's.
DETOURS = (
    ("_post_to_boss", "posts to BOSS directly, naming whatever bundle it likes"),
    ("/private/acl", "reaches BOSS's ACL routes without going through `lib.server`"),
)

NAMED_BUNDLE = re.compile(r"calling_bundle\(\s*[^)\s]")


def _grant_problems(name):
    """An app reaching past `grant_role` to name a bundle of its own choosing."""
    found = []
    directory = os.path.join(APP_DIR, name)
    for root, _, files in os.walk(directory):
        for filename in sorted(f for f in files if f.endswith(".py")):
            path = os.path.join(root, filename)
            relative = os.path.relpath(path, REPO)
            try:
                text = open(path).read()
            except OSError:
                continue
            for line_number, line in enumerate(text.split("\n"), 1):
                if line.lstrip().startswith("#"):
                    continue
                for token, why in DETOURS:
                    if token in line:
                        found.append(f"  ERROR   {name}: {relative}:{line_number}"
                                     f" {why}")
                if NAMED_BUNDLE.search(line):
                    found.append(f"  ERROR   {name}: {relative}:{line_number}"
                                 f" names a bundle rather than letting"
                                 f" `calling_bundle` read its own")
    return found


def main():
    if not os.path.isdir(APP_DIR):
        print("  no private services")
        return 0

    names = sorted(n for n in os.listdir(APP_DIR)
                   if os.path.isdir(os.path.join(APP_DIR, n))
                   and not n.startswith("__"))
    problems = []
    for name in names:
        # An app that is planned and not yet written. `plan.md` comes before
        # the service does — that is the development order — so a directory
        # holding one and no code is a state, not a fault.
        if not os.path.isfile(os.path.join(APP_DIR, name, "__init__.py")):
            if os.path.isfile(os.path.join(APP_DIR, name, "plan.md")):
                problems.append(f"  warning {name}: planned, not yet written")
                continue

        # Before the import, because this reads the source rather than the
        # module — and an app that does not import is exactly one somebody is
        # in the middle of changing.
        problems.extend(_grant_problems(name))

        module, error = load(name)
        if error is not None:
            problems.append(f"  ERROR   {name}: does not import\n"
                            + "\n".join(f"          {l}" for l in error.split("\n")))
            continue
        if not hasattr(module, "router"):
            problems.append(f"  ERROR   {name}: has no `router`, so `api.py` skips it")
            continue
        routes = len(getattr(module.router, "routes", []))
        if routes == 0:
            problems.append(f"  ERROR   {name}: its router carries no routes")
            continue

        problems.extend(_model_problems(name))
        problems.extend(_shape_problems(name))
        problems.extend(_route_problems(name, module))
        problems.extend(_database_problems(name, module))

    warnings = [p for p in problems if p.startswith("  warning")]
    errors = [p for p in problems if p.startswith("  ERROR")]
    if warnings:
        print("\n".join(warnings))
    if errors:
        print("\n".join(errors))
        print(f"\n{len(errors)} problem(s) would stop a service being served")
        return 1
    if warnings:
        print(f"\n{len(names)} service(s) load; see the warnings above")
        return 0

    print(f"Checked {len(names)} service(s).")
    print("Every one imports and mounts its router.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
