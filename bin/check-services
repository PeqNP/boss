#!/usr/bin/env python3
#
# Verify that every private service still loads.
#
# `api.py` imports each app under `private/app/` and appends its `router`. An
# app whose module raises during import is logged and skipped:
#
#     try:
#         spec.loader.exec_module(module)
#     except Exception as e:
#         logging.error(...)
#         continue
#
# So a broken app does not stop the service. The service starts, binds its
# port, and answers every request for that app with FastAPI's own 404 — a total
# outage of one app, wearing the costume of a routing mistake. An app with no
# `router` attribute is skipped the same way.
#
# The one record of it is a log line, and `private/start` sends the service's
# output to /dev/null. Nothing else notices, which is what this is for.
#
# The tests do not cover it: they import `lib` directly and never load the
# router, so a suite can be entirely green while the service serves nothing.
#
# What this does not do is call `start()`. That would create and migrate real
# databases, which a check has no business doing. Worth knowing that `api.py`
# calls it *outside* the try above, so an exception there is not caught at all
# and takes down every app rather than one.
#
# Usage:
#   bin/check-services
#

import importlib.util
import os
import re
import sys
import traceback

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
APP_DIR = os.path.join(REPO, "private", "app")

# `api.py` runs with `private/` as its working directory, so an app's
# `from lib import …` resolves. Added explicitly rather than left to whatever
# directory this is run from.
sys.path.insert(0, os.path.join(REPO, "private"))


def load(name):
    """Import an app the way `api.py` does. Returns the module or an error."""
    path = os.path.join(APP_DIR, name, "__init__.py")
    if not os.path.isfile(path):
        return None, "no __init__.py"

    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    # As `api.py` does, so relative imports inside the app resolve.
    sys.modules[name] = module
    try:
        spec.loader.exec_module(module)
    except Exception:
        return None, traceback.format_exc(limit=3).strip()
    return module, None


CLASS_DEF = re.compile(r"^class (\w+)\(", re.M)
# A decorator may wrap across lines once its arguments are long, so this reads
# to the closing bracket rather than to the end of the line. Counting only
# single-line ones made four routes invisible — neither declared nor missing.
ROUTE_DEF = re.compile(r"^@router\.(\w+)\((.*?)\)\s*\n(?=@|async |def )",
                       re.M | re.S)


def _model_problems(name):
    """A model name declared twice is always a bug.

    Python keeps the last definition, so the earlier one is shadowed with
    nothing said. A route declaring it then returns a shape nobody wrote.
    """
    path = os.path.join(APP_DIR, name, "model.py")
    if not os.path.isfile(path):
        return []
    seen, twice = set(), []
    for match in CLASS_DEF.finditer(open(path).read()):
        if match.group(1) in seen:
            twice.append(match.group(1))
        seen.add(match.group(1))
    return [f"  ERROR   {name}: model.py declares {n} twice; the first is shadowed"
            for n in sorted(set(twice))]


def _route_problems(name, module):
    """Routes that do not say what shape they return.

    `response_model=` is what binds a route to a model, and it is what
    `bin/validate-app` reads to ask whether every field the client takes off
    that route exists on it. Without one, only the weaker question is asked —
    does *any* model declare this field — which passes for a field that is real
    somewhere else entirely.

    A warning: a route still returning its Stage 1 fixture has nothing to
    declare yet, and the count is what is left to wire.
    """
    path = os.path.join(APP_DIR, name, "__init__.py")
    if not os.path.isfile(path):
        return []
    text = open(path).read()
    routes = ROUTE_DEF.findall(text)
    if not routes:
        return []
    undeclared = [args for _, args in routes if "response_model=" not in args]
    if not undeclared:
        return []
    return [f"  warning {name}: {len(undeclared)} of {len(routes)} routes"
            f" declare no response_model"]


def main():
    if not os.path.isdir(APP_DIR):
        print("  no private services")
        return 0

    names = sorted(n for n in os.listdir(APP_DIR)
                   if os.path.isdir(os.path.join(APP_DIR, n))
                   and not n.startswith("__"))
    problems = []
    for name in names:
        module, error = load(name)
        if error is not None:
            problems.append(f"  ERROR   {name}: does not import\n"
                            + "\n".join(f"          {l}" for l in error.split("\n")))
            continue
        if not hasattr(module, "router"):
            problems.append(f"  ERROR   {name}: has no `router`, so `api.py` skips it")
            continue
        routes = len(getattr(module.router, "routes", []))
        if routes == 0:
            problems.append(f"  ERROR   {name}: its router carries no routes")
            continue

        # An app may offer `db.schema_drift()`, which names the tables its DDL
        # declares and its database does not have. There are no migrations
        # while a schema is still moving, so drift is ordinary — but it surfaces
        # as a 500 from whichever route touches the missing table, pointing
        # away from itself.
        problems.extend(_model_problems(name))
        problems.extend(_route_problems(name, module))

        drift = getattr(getattr(module, "db", None), "schema_drift", None)
        if drift is not None:
            missing = drift()
            if missing:
                problems.append(
                    f"  ERROR   {name}: its database is missing"
                    f" {', '.join(missing)} — delete it and restart"
                )

    warnings = [p for p in problems if p.startswith("  warning")]
    errors = [p for p in problems if p.startswith("  ERROR")]
    if warnings:
        print("\n".join(warnings))
    if errors:
        print("\n".join(errors))
        print(f"\n{len(errors)} problem(s) would stop a service being served")
        return 1
    if warnings:
        print(f"\n{len(names)} service(s) load; see the warnings above")
        return 0

    print(f"Checked {len(names)} service(s).")
    print("Every one imports and mounts its router.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
