#!/usr/bin/env zsh
#
# Follow service logs in tmux. `tail -F` writes as soon as the file grows;
# a delay is the writer buffering, not this script.
#
# Usage:
#   bin/watchlogs              # Python (`log_path`/boss) and Swift
#   bin/watchlogs log1 log2    # those files instead
#

set -euo pipefail

log_dir=$(awk -F': *' '/^log_path:/{print $2; exit}' ~/.boss/config)
if [[ $# -eq 0 ]]; then
    logs=()
    [[ -n "$log_dir" ]] && logs+=("${log_dir}/boss")
    logs+=("/tmp/boss-vapor.log")
else
    logs=("$@")
fi

if [[ ${#logs} -lt 1 ]]; then
    echo "usage: $0 [log ...]" >&2
    exit 1
fi

SESSION=logs
tmux has-session -t "$SESSION" 2>/dev/null && tmux kill-session -t "$SESSION"

tmux new-session -d -s "$SESSION" -n monitor "tail -n 200 -F '${logs[1]}'"
for ((i = 2; i <= ${#logs}; i++)); do
    tmux split-window -h -t "$SESSION":0 "tail -n 200 -F '${logs[i]}'"
done
tmux select-layout -t "$SESSION":0 even-horizontal
tmux select-pane -t "$SESSION":0.0
tmux attach -t "$SESSION"
