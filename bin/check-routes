#!/usr/bin/env python3
#
# Routes a service had and no longer has, and routes it declares twice.
#
# Editing a route file by replacing a span between two markers removes whatever
# else was between them. It happened once: a slice from `/admin/schedule/month`
# to `/admin/jobs/unassigned` took `/admin/employees` with it, and the only
# symptom was a route count one lower than before and a checker calling a wired
# route unmodelled.
#
# Comparing against a commit is what makes that visible. `HEAD` by default,
# which is every route the service had before this session's work.
#
# The same edit inserting a replacement without removing the original leaves
# two handlers on one path. FastAPI serves whichever was registered first, so
# the symptom is a stub answering after the real one was written, or dead code
# nobody reads. Both are found by counting.
#
# It fails closed. A run that cannot read either side says so rather than
# reporting every route as lost — the shape a hand-rolled version of this took
# four times, always by being run from the wrong directory.
#
# Usage:
#   bin/check-routes                 # every app, against HEAD
#   bin/check-routes io.bithead.scheduler
#   bin/check-routes --against <ref>
#

import os
import re
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
APP_DIR = os.path.join(REPO, "private", "app")

ROUTE = re.compile(r'@router\.(get|post|put|delete)\(\s*"([^"]+)"')


class Unreadable(Exception):
    """Neither side can be compared, so nothing is claimed about it."""


def routes_in(text):
    return {f"{verb} {path}" for verb, path in ROUTE.findall(text)}


def declared_twice(text):
    """Paths with more than one handler, and how many each has."""
    counts = {}
    for verb, path in ROUTE.findall(text):
        route = f"{verb} {path}"
        counts[route] = counts.get(route, 0) + 1
    return {route: n for route, n in counts.items() if n > 1}


def source_of(bundle):
    return os.path.join(APP_DIR, bundle, "__init__.py")


def routes_now(bundle):
    path = source_of(bundle)
    if not os.path.isfile(path):
        raise Unreadable(f"no {os.path.relpath(path, REPO)}")
    return routes_in(open(path).read())


def routes_at(bundle, ref):
    relative = os.path.join("private", "app", bundle, "__init__.py")
    result = subprocess.run(
        ["git", "show", f"{ref}:{relative}"],
        cwd=REPO, capture_output=True, text=True
    )
    if result.returncode != 0:
        raise Unreadable(f"{ref} has no {relative}")
    return routes_in(result.stdout)


def main(argv):
    ref = "HEAD"
    if "--against" in argv:
        at = argv.index("--against")
        if at + 1 >= len(argv):
            print("  --against wants a commit")
            return 2
        ref = argv[at + 1]
        argv = argv[:at] + argv[at + 2:]

    if argv:
        bundles = argv
    else:
        bundles = sorted(n for n in os.listdir(APP_DIR)
                         if os.path.isdir(os.path.join(APP_DIR, n))
                         and not n.startswith("__"))

    problems, checked = [], 0
    for bundle in bundles:
        try:
            before, after = routes_at(bundle, ref), routes_now(bundle)
        except Unreadable as e:
            # A new app has no history and an old one may have been removed.
            # Either way nothing is claimed about it.
            continue

        if not before:
            continue
        checked += 1

        lost = sorted(before - after)
        if lost:
            problems.append(f"  ERROR   {bundle}: {len(lost)} route(s) present"
                            f" in {ref} and gone now:")
            problems.extend(f"            {route}" for route in lost)

        twice = declared_twice(open(source_of(bundle)).read())
        if twice:
            problems.append(f"  ERROR   {bundle}: {len(twice)} route(s) declared"
                            f" more than once. The first registered serves:")
            problems.extend(f"            {route} ({n} handlers)"
                            for route, n in sorted(twice.items()))

    if problems:
        print("\n".join(problems))
        print(f"\nA route that disappears answers 404 and reads as a routing"
              f" mistake. One declared twice serves whichever came first.")
        return 1

    print(f"Checked {checked} service(s) against {ref}.")
    print("Every route they had, they still have, and each is declared once.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
