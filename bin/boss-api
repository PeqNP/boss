#!/usr/bin/env python3
#
# Generate the BOSS JavaScript API index.
#
# Writes docs/prompt/js-api.md — a per-component list of every public method
# exported by the OS JavaScript, so an agent can answer "does UIListBox have
# disableOption?" without reading 6,000 lines of ui.js.
#
# The same method name is defined by several components (UIListBox, UIPopupMenu,
# UIMenu, and UISearchMenu all define `selectOption`), so a bare grep answers
# "does this name exist somewhere" — not "does it exist on the component I am
# holding". That distinction is what this index provides.
#
# Usage:
#   bin/boss-api            # regenerate docs/prompt/js-api.md
#   bin/boss-api --check    # exit 1 if the committed file is stale
#

import os
import re
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUTPUT = os.path.join(REPO, "docs/prompt/js-api.md")

SOURCES = [
    "public/boss/ui.js",
    "public/boss/os.js",
    "public/boss/network.js",
    "public/boss/foundation.js",
    "public/boss/notification-manager.js",
    "public/boss/application-manager.js",
    "public/boss/ui-desktop.js",
    "public/boss/ui-notification.js",
]

# A top-level `function Name(` or `class Name {` opens a component. Everything
# assigned to `this.` until the next top-level declaration belongs to it.
TOP_LEVEL = re.compile(r"^(?:function\s+(\w+)\s*\(|class\s+(\w+))")
EXPORT = re.compile(r"^\s+this\.(\w+)\s*=\s*(\w+)?")
PROPERTY = re.compile(r"^\s+(?:readOnly|property)\(this,\s*[\"'](\w+)[\"']")
SIGNATURE = re.compile(r"^\s*function\s+(\w+)\s*\(([^)]*)\)")
PROTOCOL = re.compile(r"protocol\(\s*$|protocol\(")


def parse(path):
    """Return {component: {"methods": [(name, params)], "protocol": [names]}}."""
    with open(os.path.join(REPO, path)) as handle:
        lines = handle.read().splitlines()

    components = {}
    current = os.path.basename(path)
    components[current] = {"methods": [], "protocol": [], "line": 1}
    signatures = {}
    in_protocol = None

    for index, line in enumerate(lines, start=1):
        top = TOP_LEVEL.match(line)
        if top is not None:
            current = top.group(1) or top.group(2)
            components.setdefault(current, {"methods": [], "protocol": [], "line": index})
            signatures = {}

        signature = SIGNATURE.match(line)
        if signature is not None:
            signatures[signature.group(1)] = signature.group(2).strip()

        # Delegate protocol names are declared as bare strings inside a
        # protocol(...) call. Capture them so delegate contracts are listed.
        if "protocol(" in line:
            in_protocol = True
        if in_protocol:
            for name in re.findall(r'^\s*"(\w+)"', line):
                # The first string argument is the protocol's own type name
                # (e.g. "UIListBoxDelegate"), not one of its methods.
                if name.endswith("Delegate"):
                    continue
                components[current]["protocol"].append(name)
            if line.rstrip().endswith(");"):
                in_protocol = False

        export = EXPORT.match(line)
        if export is not None:
            name = export.group(1)
            if name in ("events", "delegate"):
                continue
            params = signatures.get(export.group(2) or name, "")
            components[current]["methods"].append((name, params))

        prop = PROPERTY.match(line)
        if prop is not None:
            components[current]["methods"].append((prop.group(1), "«property»"))

    return components


def render():
    out = []
    out.append("# BOSS JavaScript API Index")
    out.append("")
    out.append("**Generated by `bin/boss-api` — do not edit by hand.**")
    out.append("")
    out.append("Every public method, grouped by the component that defines it. Use this to")
    out.append("confirm a method exists **on the component you are holding** before calling it.")
    out.append("")
    out.append("Several components define the same method name (`selectOption` is on")
    out.append("`UIListBox`, `UIPopupMenu`, `UIMenu`, and `UISearchMenu`), so grepping for a")
    out.append("name only proves it exists *somewhere*. Check the component's own row.")
    out.append("")
    out.append("For usage patterns and HTML markup, see [`js.md`](js.md). This file is the")
    out.append("surface only.")
    out.append("")

    for path in SOURCES:
        if not os.path.exists(os.path.join(REPO, path)):
            continue
        components = parse(path)
        rendered = []
        for name, data in sorted(components.items(), key=lambda kv: kv[1]["line"]):
            if not data["methods"] and not data["protocol"]:
                continue
            rendered.append((name, data))
        if not rendered:
            continue

        out.append("---")
        out.append("")
        out.append(f"## `{path}`")
        out.append("")
        for name, data in rendered:
            out.append(f"### `{name}`")
            out.append("")
            if data["protocol"]:
                unique = sorted(set(data["protocol"]))
                out.append("**Delegate methods:** " + ", ".join(f"`{p}`" for p in unique))
                out.append("")
            if data["methods"]:
                seen = set()
                items = []
                for method, params in data["methods"]:
                    if method in seen:
                        continue
                    seen.add(method)
                    if params == "«property»":
                        items.append(f"`{method}`")
                    else:
                        items.append(f"`{method}({params})`")
                out.append(" · ".join(items))
                out.append("")
    return "\n".join(out) + "\n"


def main():
    content = render()
    if "--check" in sys.argv:
        if not os.path.exists(OUTPUT):
            print("js-api.md is missing. Run bin/boss-api.")
            return 1
        with open(OUTPUT) as handle:
            if handle.read() != content:
                print("js-api.md is stale. Run bin/boss-api.")
                return 1
        print("js-api.md is up to date.")
        return 0
    with open(OUTPUT, "w") as handle:
        handle.write(content)
    print(f"Wrote {os.path.relpath(OUTPUT, REPO)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
